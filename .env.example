DATABASE_URL=
SESSION_SECRET=
APP_URL=

# Optional S3-compatible object storage.
# Railway Buckets expose ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, BUCKET, and REGION.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PUBLIC_URL=

# Optional backup override if backups should use a different bucket.
BACKUP_OBJECT_STORAGE_ENDPOINT=
BACKUP_OBJECT_STORAGE_ACCESS_KEY_ID=
BACKUP_OBJECT_STORAGE_SECRET_ACCESS_KEY=
BACKUP_OBJECT_STORAGE_BUCKET=
BACKUP_OBJECT_STORAGE_REGION=auto
BACKUP_OBJECT_STORAGE_PREFIX=system-backups

